{
  "name": "wildlife-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "REST API + PostgreSQL backend for the Wildlife Conservation Management System",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:check": "tsx db/check.ts",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed.ts",
    "db:setup": "npm run migrate && npm run seed"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
