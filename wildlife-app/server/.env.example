# Wildlife Conservation Management System - backend environment
# Copy this file to `.env` and fill in your PostgreSQL credentials.

# HTTP server
PORT=4000

# Comma separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Optional: a single connection string takes precedence over the PG* values below.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wildlife

# Fallback connection settings (used when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=wildlife
